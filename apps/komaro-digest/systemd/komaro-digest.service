[Unit]
Description=SuziePi KOMARO sensor digest (LVGL on /dev/fb1)
Wants=network-online.target
After=local-fs.target systemd-udevd.service network-online.target
# Only one app can use the screen: starting this one stops the clock.
Conflicts=clock.service

[Service]
Type=simple
User=pi
SupplementaryGroups=video input
ExecStart=/home/pi/bin/komaro-digest
# Restart after a crash, but not after the on-screen Exit button (exit code 0).
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
